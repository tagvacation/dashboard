# ── Per-user GCP (multi-tenant) ──────────────────────────────────────────────
# Service-account keys now live ENCRYPTED in the DB, one per user (added in the app
# under Profile → Accounts). There is NO shared runtime default account.
#
# GCS_SERVICE_ACCOUNT_JSON + GCS_BUCKET below are only needed (a) at BUILD time
# (Docker uses placeholders), and (b) once, to run scripts/seed-admin-gcp-cred.mts
# which migrates the admin's account into the DB. After that they can be dropped at runtime.
GCS_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...",...}
GCS_BUCKET=your_bucket

# Secret used to AES-256-GCM encrypt users' service-account keys at rest. REQUIRED.
# Generate: openssl rand -base64 32
APP_ENCRYPTION_KEY=replace_with_base64_32_byte_key

# Google Sheet
SHEET_ID=11m9qc_j43JtIN1EnRrCw1nK6AZ9y4Snn6DoWWUiNkMw
SHEET_TAB=Sheet2

# Dashboard auth
DASHBOARD_PASSWORD=choose_a_strong_password

# NextAuth session signing secret (run: openssl rand -base64 32)
NEXTAUTH_SECRET=replace_with_random_secret

# Email OTP delivery (nodemailer SMTP). For Gmail use an App Password.
# If these are left blank, OTP codes are printed to the server console (dev only).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=your_16_char_app_password
SMTP_FROM=AI Studio <you@gmail.com>
